{
  "name": "dsh-termux-shell",
  "version": "0.1.1",
  "description": "Termux/Android shell tool (termux_bash) for DeepSeek Harness: runs bash without a sandbox backend",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./termux": "./lib/termux.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/termux.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuimu1hao/dsh-termux-shell.git"
  },
  "homepage": "https://github.com/shuimu1hao/dsh-termux-shell",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "test": "node --test"
  }
}
